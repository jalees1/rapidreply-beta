# App
NEXTAUTH_URL=http://localhost:3000
# If using a public HTTPS host, set this and NEXTAUTH_URL to the same host,
# and register the exact URI under Instagram > API setup > OAuth redirect URIs.
# INSTAGRAM_REDIRECT_URI=https://your-public-host/api/instagram/callback
NEXTAUTH_SECRET=replace-with-a-strong-random-secret
CRON_SECRET=replace-with-a-strong-random-secret
ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# Database / queue
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/rapidreply
REDIS_URL=redis://localhost:6379
# Webhook jobs wake the worker immediately; this reduces idle Redis polling.
QUEUE_DRAIN_DELAY_SECONDS=30
DM_WORKER_CONCURRENCY=1

# Optional: restrict who can create accounts and sign in. Comma separated,
# case insensitive. Leave unset to allow account registration.
# ALLOWED_EMAILS=you@example.com,teammate@example.com

# Meta / Instagram
META_GRAPH_API_VERSION=v25.0
INSTAGRAM_APP_ID=your-instagram-app-id
INSTAGRAM_APP_SECRET=your-instagram-app-secret
FACEBOOK_APP_SECRET=your-facebook-app-secret
WEBHOOK_VERIFY_TOKEN=replace-with-a-webhook-verify-token
